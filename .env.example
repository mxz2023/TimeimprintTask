# TimeImprintTask 独立运行环境变量模板

SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18080
SHUTDOWN_GRACE_SECONDS=40
DB_JDBC_URL=jdbc:mysql://127.0.0.1:3306/timeimprint_task_local?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC
DB_USERNAME=tit
DB_PASSWORD=
INSTANCE_ID=local-1
LOCAL_TENANT_ID=local-tenant
LOCAL_ACTOR_ID=local-actor
TEST_TENANT_ID=test-tenant
TEST_ACTOR_ID=test-actor
WORKER_ENABLED=true
CLAIM_BATCH_SIZE=50
SIGNAL_SCAN_MS=1000
ACTION_SCAN_MS=1000

# 必须包含 IN_APP；启用飞书时填写 IN_APP,FEISHU。
TIMEIMPRINT_NOTIFICATION_DELIVERYCHANNELS=IN_APP
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_TIMEOUT_SECONDS=5
# 启用 FEISHU 后填写 local-actor 对应的飞书 open_id。
TIMEIMPRINT_NOTIFICATION_FEISHU_RECIPIENT_MAP_LOCAL_ACTOR=
