<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.net.mxz.timeimprint.task.service.storage.mysql.mapper.TaskTransitionMapper">

    <resultMap id="RM" type="cn.net.mxz.timeimprint.task.service.storage.mysql.row.TaskTransitionRow">
        <id property="transitionId" column="transition_id"/>
        <result property="definitionId" column="definition_id"/>
        <result property="instanceId" column="instance_id"/>
        <result property="sourceType" column="source_type"/>
        <result property="sourceKey" column="source_key"/>
        <result property="commandKey" column="command_key"/>
        <result property="fromControlState" column="from_control_state"/>
        <result property="toControlState" column="to_control_state"/>
        <result property="fromLifecycle" column="from_lifecycle"/>
        <result property="toLifecycle" column="to_lifecycle"/>
        <result property="fromScenarioState" column="from_scenario_state"/>
        <result property="toScenarioState" column="to_scenario_state"/>
        <result property="fromRevision" column="from_revision"/>
        <result property="toRevision" column="to_revision"/>
        <result property="actorType" column="actor_type"/>
        <result property="actorId" column="actor_id"/>
        <result property="summaryJson" column="summary_json"/>
        <result property="traceId" column="trace_id"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="transitionId">
        INSERT INTO tt_task_transition (definition_id, instance_id, source_type, source_key, command_key,
            from_control_state, to_control_state, from_lifecycle, to_lifecycle,
            from_scenario_state, to_scenario_state, from_revision, to_revision,
            actor_type, actor_id, summary_json, trace_id, created_at)
        VALUES (#{definitionId}, #{instanceId}, #{sourceType}, #{sourceKey}, #{commandKey},
            #{fromControlState}, #{toControlState}, #{fromLifecycle}, #{toLifecycle},
            #{fromScenarioState}, #{toScenarioState}, #{fromRevision}, #{toRevision},
            #{actorType}, #{actorId}, #{summaryJson}, #{traceId}, #{createdAt})
    </insert>

    <select id="selectById" resultMap="RM">
        SELECT * FROM tt_task_transition WHERE transition_id = #{transitionId}
    </select>

    <select id="selectByDefinitionId" resultMap="RM">
        SELECT * FROM tt_task_transition
        WHERE 1=1
        <if test="definitionId != null">AND definition_id = #{definitionId}</if>
        <if test="instanceId != null">AND instance_id = #{instanceId}</if>
        <if test="cursor != null">AND transition_id &lt; #{cursor}</if>
        ORDER BY transition_id DESC
        LIMIT #{limit}
    </select>

</mapper>
